# ============================================
# Node.js / NestJS
# ============================================

# Compiled output
/dist
/build
/node_modules

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ============================================
# Environment Variables (SECRETS - NEVER COMMIT)
# ============================================

# Environment files with real secrets
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ============================================
# Database Files (Local database - NEVER COMMIT)
# ============================================

# SQLite databases
*.db
*.db-journal
*.sqlite
*.sqlite3

# Prisma
prisma/*.db
prisma/*.db-journal
prisma/dev.db
prisma/*.db-journal

# ============================================
# Testing
# ============================================

/coverage
/.nyc_output
*.test.js
*.spec.js

# ============================================
# OS Files
# ============================================

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ============================================
# IDE / Editor Files
# ============================================

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ / WebStorm / PhpStorm
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# ============================================
# Temporary Files
# ============================================

.temp
.tmp
tmp/
temp/
*.swp
*.swo
*~

# ============================================
# Build / Dependency Files
# ============================================

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# ============================================
# Docker
# ============================================

# Docker volumes
/volumes/
*.pid

# ============================================
# Other
# ============================================

# Configuration files with local settings
*.local

# Backup files
*.bak
*.backup